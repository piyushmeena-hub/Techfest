<?xml version="1.0" ?>
<!--
  UAV-X Disaster Zone Simulation World
  =====================================
  Gazebo SDF 1.7 world for simulating UAV disaster-response operations.

  Scene elements:
    - Physics:        ODE solver, 4 ms step, real-time factor 1.0
    - Lighting:       Directional sun + ambient fill
    - Atmosphere:     Light fog (humidity 0.8) to simulate post-disaster haze
    - Wind:           2 m/s eastward, 1 m/s northward gusts
    - Ground:         Large grey tarmac plane
    - Buildings:      5 collapsed structures as low flat boxes
    - PoI markers:    7 cylinders colour-coded by survivor priority
    - GCS marker:     Green box at coordinate origin
-->
<sdf version="1.7">
  <world name="disaster_zone">

    <!-- ================================================================ -->
    <!-- PHYSICS                                                           -->
    <!-- ================================================================ -->
    <physics name="default_physics" type="ode">
      <!-- Step size: 4 ms → 250 Hz simulation rate -->
      <max_step_size>0.004</max_step_size>
      <!-- Run at real-time: 1.0 means 1 sim-second per 1 wall-second -->
      <real_time_factor>1</real_time_factor>
      <!-- Maximum number of contacts between two bodies -->
      <max_contacts>20</max_contacts>
      <ode>
        <solver>
          <!-- Quick solver is more stable for articulated bodies -->
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================================================================ -->
    <!-- SCENE SETTINGS                                                    -->
    <!-- ================================================================ -->
    <scene>
      <!-- Ambient light: dim bluish overcast sky -->
      <ambient>0.4 0.4 0.5 1</ambient>
      <!-- Sky background colour (grey haze) -->
      <background>0.6 0.6 0.65 1</background>
      <!-- Shadows add realism and help with depth perception -->
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ================================================================ -->
    <!-- ATMOSPHERE                                                        -->
    <!-- Simulates post-disaster atmospheric conditions:                   -->
    <!-- light fog from fires and debris dust                              -->
    <!-- ================================================================ -->
    <atmosphere type="adiabatic">
      <temperature>293.15</temperature>       <!-- 20 °C -->
      <pressure>101325</pressure>             <!-- Sea-level Pa -->
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <!-- Fog (part of scene visual settings) -->
    <scene>
      <fog>
        <color>0.85 0.85 0.80 1</color>
        <type>linear</type>
        <start>200</start>
        <end>1800</end>
        <density>0.8</density>               <!-- humidity proxy: 0.8 -->
      </fog>
    </scene>

    <!-- ================================================================ -->
    <!-- WIND                                                              -->
    <!-- Linear velocity: 2 m/s east (+X), 1 m/s north (+Y), 0 vertical  -->
    <!-- ================================================================ -->
    <wind>
      <linear_velocity>2 1 0</linear_velocity>
    </wind>

    <!-- ================================================================ -->
    <!-- SUN – directional light (low angle: late afternoon)              -->
    <!-- ================================================================ -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 1000 0 0.5 0</pose>
      <!-- Low-sun tinted light, slightly warm/orange after disaster smoke -->
      <diffuse>0.9 0.85 0.7 1</diffuse>
      <specular>0.3 0.3 0.25 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ambient fill light to soften harsh shadows -->
    <light name="ambient_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 500 0 -0.5 3.14</pose>
      <diffuse>0.3 0.3 0.4 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.5 -0.1 -0.5</direction>
    </light>

    <!-- ================================================================ -->
    <!-- GROUND PLANE                                                      -->
    <!-- 3000 × 2000 m grey concrete/tarmac surface                       -->
    <!-- ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3000 2000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3000 2000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <!-- Fallback RGBA: dark grey asphalt -->
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- COLLAPSED BUILDINGS (5 structures)                               -->
    <!--                                                                   -->
    <!-- Represented as flat, low boxes to simulate collapsed multi-storey -->
    <!-- structures.  Rubble piles typically 2-4 m tall.                  -->
    <!--                                                                   -->
    <!-- Positions (x, y, 0):                                              -->
    <!--   Building 0: (500, 300, 0)   Size: 20 × 15 × 3                 -->
    <!--   Building 1: (900, 100, 0)   Size: 25 × 18 × 2.5               -->
    <!--   Building 2: (700, 900, 0)   Size: 22 × 12 × 3.5               -->
    <!--   Building 3: (1200, 600, 0)  Size: 30 × 20 × 2                 -->
    <!--   Building 4: (300, 1100, 0)  Size: 18 × 14 × 4                 -->
    <!-- ================================================================ -->

    <!-- Building 0 ---------------------------------------------------- -->
    <model name="collapsed_building_0">
      <static>true</static>
      <!-- Centre position: x=500, y=300, z=half-height=1.5 -->
      <pose>500 300 1.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20 15 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20 15 3</size></box>
          </geometry>
          <material>
            <ambient>0.50 0.47 0.43 1</ambient>   <!-- concrete grey -->
            <diffuse>0.55 0.52 0.48 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rubble detail for building 0 (smaller offset boxes) -->
    <model name="rubble_0a">
      <static>true</static>
      <pose>510 308 0.75 0.1 0.05 1.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 4 1.5</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.38 1</ambient>
            <diffuse>0.50 0.47 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 1 ---------------------------------------------------- -->
    <model name="collapsed_building_1">
      <static>true</static>
      <pose>900 100 1.25 0 0 -0.15</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>25 18 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>25 18 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.48 0.45 0.41 1</ambient>
            <diffuse>0.53 0.50 0.46 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rubble detail for building 1 -->
    <model name="rubble_1a">
      <static>true</static>
      <pose>912 108 0.6 0.05 0.12 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 3 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 3 1.2</size></box></geometry>
          <material>
            <ambient>0.43 0.40 0.36 1</ambient>
            <diffuse>0.48 0.45 0.41 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 2 ---------------------------------------------------- -->
    <model name="collapsed_building_2">
      <static>true</static>
      <pose>700 900 1.75 0 0 0.7</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>22 12 3.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>22 12 3.5</size></box>
          </geometry>
          <material>
            <ambient>0.52 0.49 0.44 1</ambient>
            <diffuse>0.57 0.54 0.49 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 3 ---------------------------------------------------- -->
    <model name="collapsed_building_3">
      <static>true</static>
      <pose>1200 600 1.0 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>30 20 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>30 20 2</size></box>
          </geometry>
          <material>
            <ambient>0.46 0.43 0.39 1</ambient>
            <diffuse>0.51 0.48 0.44 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 4 ---------------------------------------------------- -->
    <model name="collapsed_building_4">
      <static>true</static>
      <pose>300 1100 2.0 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>18 14 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>18 14 4</size></box>
          </geometry>
          <material>
            <ambient>0.54 0.51 0.46 1</ambient>
            <diffuse>0.59 0.56 0.51 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- POINT-OF-INTEREST MARKERS (7 cylinders)                          -->
    <!--                                                                   -->
    <!-- Colour coding by survivor priority:                               -->
    <!--   CRITICAL  → Red    (0: 500,300)   (1: 900,100)                -->
    <!--   HIGH      → Orange (2: 700,900)   (3: 1200,600)               -->
    <!--   MEDIUM    → Yellow (4: 300,1100)  (5: 600,500)                -->
    <!--   LOW       → Green  (6: 1000,800)                               -->
    <!--                                                                   -->
    <!-- Each marker: radius=2 m, height=1 m, placed at ground level      -->
    <!-- The cylinder is offset +3 m on Z from the collapsed building so  -->
    <!-- it is visible from UAV cameras above.                             -->
    <!-- ================================================================ -->

    <!-- PoI 0 – CRITICAL – Red – near Building 0 (500,300) -->
    <model name="poi_marker_0_critical">
      <static>true</static>
      <pose>500 300 4.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
          <material>
            <!-- Bright red: highest priority survivors trapped -->
            <ambient>0.9 0.05 0.05 1</ambient>
            <diffuse>1.0 0.1 0.1 1</diffuse>
            <specular>0.3 0.1 0.1 1</specular>
            <emissive>0.4 0.0 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- PoI 1 – CRITICAL – Red – near Building 1 (900,100) -->
    <model name="poi_marker_1_critical">
      <static>true</static>
      <pose>900 100 3.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.05 0.05 1</ambient>
            <diffuse>1.0 0.1 0.1 1</diffuse>
            <specular>0.3 0.1 0.1 1</specular>
            <emissive>0.4 0.0 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- PoI 2 – HIGH – Orange – near Building 2 (700,900) -->
    <model name="poi_marker_2_high">
      <static>true</static>
      <pose>700 900 5.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
          <material>
            <!-- Orange: high priority -->
            <ambient>0.9 0.45 0.0 1</ambient>
            <diffuse>1.0 0.55 0.0 1</diffuse>
            <specular>0.3 0.2 0.0 1</specular>
            <emissive>0.3 0.15 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- PoI 3 – HIGH – Orange – near Building 3 (1200,600) -->
    <model name="poi_marker_3_high">
      <static>true</static>
      <pose>1200 600 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.0 1</ambient>
            <diffuse>1.0 0.55 0.0 1</diffuse>
            <specular>0.3 0.2 0.0 1</specular>
            <emissive>0.3 0.15 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- PoI 4 – MEDIUM – Yellow – near Building 4 (300,1100) -->
    <model name="poi_marker_4_medium">
      <static>true</static>
      <pose>300 1100 4.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
          <material>
            <!-- Yellow: medium priority -->
            <ambient>0.9 0.85 0.0 1</ambient>
            <diffuse>1.0 0.95 0.0 1</diffuse>
            <specular>0.3 0.3 0.0 1</specular>
            <emissive>0.25 0.22 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- PoI 5 – MEDIUM – Yellow – interior position (600,500) -->
    <model name="poi_marker_5_medium">
      <static>true</static>
      <pose>600 500 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.85 0.0 1</ambient>
            <diffuse>1.0 0.95 0.0 1</diffuse>
            <specular>0.3 0.3 0.0 1</specular>
            <emissive>0.25 0.22 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- PoI 6 – LOW – Green – far position (1000,800) -->
    <model name="poi_marker_6_low">
      <static>true</static>
      <pose>1000 800 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>2</radius><length>1</length></cylinder>
          </geometry>
          <material>
            <!-- Green: low priority -->
            <ambient>0.1 0.75 0.1 1</ambient>
            <diffuse>0.15 0.9 0.15 1</diffuse>
            <specular>0.1 0.3 0.1 1</specular>
            <emissive>0.02 0.2 0.02 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- GCS (GROUND CONTROL STATION) MARKER                              -->
    <!-- Large flat green box at the coordinate origin (launch point)     -->
    <!-- 5 m × 5 m × 1 m, green with UAV landing X pattern on top        -->
    <!-- ================================================================ -->
    <model name="gcs_marker">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5 5 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5 5 1</size></box>
          </geometry>
          <material>
            <!-- Bright green: command post / safe zone -->
            <ambient>0.05 0.7 0.05 1</ambient>
            <diffuse>0.1 0.85 0.1 1</diffuse>
            <specular>0.1 0.4 0.1 1</specular>
            <emissive>0.0 0.2 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- GCS landing pad X arm (horizontal) -->
    <model name="gcs_pad_h">
      <static>true</static>
      <pose>0 0 1.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5 0.3 0.05</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- GCS landing pad X arm (vertical) -->
    <model name="gcs_pad_v">
      <static>true</static>
      <pose>0 0 1.05 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5 0.3 0.05</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- ROAD / PATH between GCS and Building 0                           -->
    <!-- Thin flat rectangle for visual orientation                       -->
    <!-- ================================================================ -->
    <model name="road_gcs_to_b0">
      <static>true</static>
      <pose>250 150 0.02 0 0 0.54</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>580 4 0.02</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- ADDITIONAL SCENE PROPS: Water tank (cylindrical obstacle)        -->
    <!-- ================================================================ -->
    <model name="water_tank_0">
      <static>true</static>
      <pose>450 650 5.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>4</radius><length>10</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>4</radius><length>10</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.55 0.6 1</ambient>
            <diffuse>0.55 0.60 0.65 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- PLUGINS                                                           -->
    <!-- ================================================================ -->

    <!-- Physics / clock plugin (required by PX4 SITL) -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>

    <!-- Scene broadcaster: streams world state over ign-transport -->
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- User commands: allows Gazebo GUI to move models, apply forces, etc. -->
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- IMU sensor system (needed for PX4 IMU plugin) -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <!-- Air pressure (barometer for PX4) -->
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure">
    </plugin>

    <!-- Magnetometer -->
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer">
    </plugin>

    <!-- GPS / NAVSAT system -->
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat">
    </plugin>

    <!-- Wind: reads <wind> element and applies forces to aerodynamic models -->
    <plugin filename="gz-sim-wind-effects-system"
            name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.001</stddev>
        </noise>
      </vertical>
    </plugin>

  </world>
</sdf>
